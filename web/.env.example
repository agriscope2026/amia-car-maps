# --- Supabase (leave empty to run the dashboard on the local demo data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only – never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Render worker (FastAPI, see worker/) ---
WORKER_URL=http://127.0.0.1:8001
WORKER_TOKEN=change-me-long-random-string

# --- Local development database (PostgreSQL + PostGIS, see "npm run db:setup") ---
# Used when the Supabase variables are empty. Users: npm run db:user -- <email> <password> [editor|admin]
DATABASE_URL=postgres://postgres@localhost:54329/agriclimate

# --- No database at all: one admin login, bundled demo data, admin work kept in web/.data/ ---
# (only used when both the Supabase variables and DATABASE_URL are empty)
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=
SESSION_SECRET=change-me-32-bytes-or-more

# --- Field submissions (optional public form) ---
SUBMISSION_ACCESS_CODE=

# --- Scheduled jobs (Vercel Cron sends "Authorization: Bearer $CRON_SECRET") ---
CRON_SECRET=
